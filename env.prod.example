# Copy this file to .env.prod and set unique secrets. Do not commit .env.prod.
APP_DOMAIN=inventory.example.com
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-password
JWT_PRIVATE_KEY_PATH=/absolute/path/to/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/absolute/path/to/jwt-public.pem
# Leave blank to disable company self-registration.
APP_REGISTRATION_CODE=
